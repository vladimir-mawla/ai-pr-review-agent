@@ -0,0 +1,17 @@
+from flask import Blueprint, request
+
+from app.services.inventory import InventoryAdjuster
+from app.services.warehouse_client import WarehouseClient
+
+inventory_bp = Blueprint("inventory", __name__)
+adjuster = InventoryAdjuster(WarehouseClient())
+
+
+@inventory_bp.route("/inventory/adjust", methods=["POST"])
+def adjust_inventory():
+    payload = request.get_json()
+    new_qty = adjuster.adjust(payload["sku"], payload["delta"], payload["reason_code"])
+    return {"sku": payload["sku"], "new_quantity": new_qty}
