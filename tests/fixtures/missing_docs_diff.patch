+class InventoryAdjuster:
+    def __init__(self, warehouse_client, threshold=10):
+        self.warehouse_client = warehouse_client
+        self.threshold = threshold
+        self._cache = {}
+
+    def adjust(self, sku, delta, reason_code):
+        current = self._cache.get(sku)
+        if current is None:
+            current = self.warehouse_client.get_quantity(sku)
+            self._cache[sku] = current
+        new_qty = current + delta
+        self._cache[sku] = new_qty
+        self.warehouse_client.set_quantity(sku, new_qty, reason_code)
+        return new_qty
+
+    def bulk_adjust(self, adjustments):
+        results = {}
+        for sku, delta, reason_code in adjustments:
+            results[sku] = self.adjust(sku, delta, reason_code)
+        return results
+
+    def needs_reorder(self, sku):
+        return self._cache.get(sku, 0) < self.threshold
diff --git a/app/api/inventory_routes.py b/app/api/inventory_routes.py
