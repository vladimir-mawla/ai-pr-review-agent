@@ -0,0 +1,29 @@
+"""Bulk-order pricing for wholesale accounts."""
+
+from app.services.pricing import TAX_RATE
+
+BULK_TIER_THRESHOLDS = [
+    (100, 0.05),
+    (500, 0.10),
+    (1000, 0.18),
+]
+
+
+def apply_bulk_discount(unit_price, quantity):
+    """Apply a tiered bulk discount based on order quantity."""
+    discount_rate = 0.0
+    for threshold, rate in BULK_TIER_THRESHOLDS:
+        if quantity >= threshold:
+            discount_rate = rate
+    subtotal = unit_price * quantity * (1 - discount_rate)
+    return subtotal * (1 + TAX_RATE)
+
+
+def wholesale_invoice_total(line_items):
+    """Sum apply_bulk_discount() across every line item in a wholesale order."""
+    total = 0.0
+    for line in line_items:
+        total += apply_bulk_discount(line["unit_price"], line["quantity"])
+    return total
