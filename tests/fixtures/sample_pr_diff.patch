-    return order_total
+def apply_discount(order_total, has_coupon, is_member):
+    """Apply the seasonal coupon discount to an order total, if present."""
+    if has_coupon:
+        order_total = order_total * (1 - SEASONAL_DISCOUNT_RATE)
+    if is_member:
+        order_total = order_total * (1 - MEMBER_DISCOUNT_RATE)
+    return order_total
+
+
+def calculate_order_total(items, has_coupon, is_member, region):
+    """Calculate the final total for a shopping cart."""
+    subtotal = 0
+    for item in items:
+        if item.get("category") == "electronics":
+            if region == "US":
+                if item.get("on_sale"):
+                    subtotal += item["price"] * 0.9
+                else:
+                    subtotal += item["price"]
+            else:
+                if item.get("on_sale"):
+                    subtotal += item["price"] * 0.9 * 1.05
+                else:
+                    subtotal += item["price"] * 1.05
+        else:
+            if region == "US":
+                if item.get("on_sale"):
+                    subtotal += item["price"] * 0.95
+                else:
+                    subtotal += item["price"]
+            else:
+                if item.get("on_sale"):
+                    subtotal += item["price"] * 0.95 * 1.05
+                else:
+                    subtotal += item["price"] * 1.05
+
+    try:
+        total_with_tax = subtotal * (1 + TAX_RATE)
+        total = apply_discount(total_with_tax, has_coupon, is_member)
+    except:
+        pass
+
+    return total
