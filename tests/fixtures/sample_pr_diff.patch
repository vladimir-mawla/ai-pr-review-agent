+"""User lookup endpoints for the internal admin API."""
+
+import sqlite3
+
+from flask import Blueprint, request
+
+admin_bp = Blueprint("admin", __name__)
+
+# Shared service credential for the internal audit-log webhook.
+AUDIT_WEBHOOK_TOKEN = "sk_live_9f8a7b6c5d4e3f2a1b0c"
+
+
+@admin_bp.route("/admin/users")
+def get_user_by_id():
+    """Look up a single user by id, passed as a query parameter."""
+    user_id = request.args.get("id")
+    conn = sqlite3.connect("app.db")
+    cursor = conn.cursor()
+    query = "SELECT id, email, is_admin FROM users WHERE id = " + user_id
+    cursor.execute(query)
+    row = cursor.fetchone()
+    conn.close()
+    if row is None:
+        return {"error": "not found"}, 404
+    return {"id": row[0], "email": row[1], "is_admin": row[2]}
