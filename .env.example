# Copy this file to .env for local development. Never commit the real .env
# (it is gitignored) — this file documents the shape only, with a placeholder
# value, not a real secret.

# Shared secret GitHub signs webhook request bodies with (HMAC-SHA256).
# When registering a real GitHub App/webhook later (M11), set this to the
# secret configured on that webhook. For local M2 development, any non-empty
# string works as long as scripts/send_signed_webhook.py is invoked with the
# same value via --secret.
GITHUB_WEBHOOK_SECRET=change-me-to-a-real-shared-secret

# Which JobQueue implementation backend.api.main.create_app() wires up by
# default (M3+). "in_memory" needs no Docker and is what the plain webhook
# tests use; "redis" is the real queue used by docker-compose.yml + the
# ARQ worker (backend/job_queue/arq_worker.py). Leave as in_memory unless
# you've run `docker compose up -d redis` and want the app itself (not
# just the integration tests) to use the real queue.
JOB_QUEUE_BACKEND=in_memory

# Redis connection string for RedisJobQueue and the ARQ worker. Defaults
# to the host port docker-compose.yml publishes locally -- 6380, not
# Redis's usual 6379, because 6379 may already be in use by an unrelated
# service on your machine (see docker-compose.yml's comment). Change the
# port here if you changed the docker-compose.yml mapping to match.
REDIS_URL=redis://localhost:6380/0

# How long (seconds) a webhook X-GitHub-Delivery id is remembered in Redis
# before its idempotency key expires. GitHub retries a failed delivery for
# roughly 24 hours, so this must comfortably outlive that window. Default
# is one week (604800s); see backend/core/settings.py for the full
# rationale.
IDEMPOTENCY_TTL_SECONDS=604800

# M5's HITL (human-in-the-loop) confidence gate. A review whose
# overall_confidence is at or above this value, AND that contains no
# CRITICAL finding, is auto-posted; otherwise (confidence below this
# threshold, OR any CRITICAL finding present regardless of confidence) it
# is queued for human review instead. Exactly-at-threshold auto-posts (the
# routing test is "below threshold", not "at or below") -- see
# backend/hitl/queue.py's route_review for the exact rule and
# tests/unit/test_hitl_gate.py for the boundary tests. Default is 0.75.
HITL_CONFIDENCE_THRESHOLD=0.75

# M6 reliability layer: retry-with-backoff, circuit breaker, and timeout
# settings guarding RedisJobQueue's real outbound calls (the idempotency
# SET and the cross-thread ARQ enqueue). See backend/reliability/ for the
# primitives and backend/job_queue/redis_arq.py for where they're wired in.

# Total attempts (including the first) per Redis call before giving up.
RETRY_MAX_ATTEMPTS=3

# Delay (seconds) before the 2nd retry attempt; grows exponentially after
# that (doubling each attempt), capped at RETRY_MAX_DELAY_SECONDS. A random
# jitter factor in [0, 1) is applied on top so concurrent callers don't
# retry in lockstep.
RETRY_BASE_DELAY_SECONDS=0.1

# Upper bound (seconds) the exponential backoff delay is clamped to.
RETRY_MAX_DELAY_SECONDS=2.0

# Bound (seconds) on each individual outbound Redis call. Replaces the
# previous hardcoded `future.result(timeout=10)` in redis_arq.py.
RELIABILITY_TIMEOUT_SECONDS=10.0

# Consecutive failures required to trip the circuit breaker guarding Redis
# to OPEN (fail-fast; no further Redis calls attempted until the reset
# window below elapses).
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# How long (seconds) the breaker stays OPEN before allowing a single
# HALF_OPEN probe call through to check whether Redis has recovered.
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# M7 events spine: the append-only agent_events table (see
# backend/database/migrations/0001_agent_events.sql and backend/observability/).
# Host port 5433, not Postgres's usual 5432 -- see docker-compose.yml's
# postgres service comment for why (an unrelated project's container
# already occupies 5432 on the build machine).

# What application code (backend.observability) actually writes events
# through: the restricted agent_events_writer role the migration creates,
# granted only SELECT+INSERT on agent_events (UPDATE/DELETE explicitly
# revoked). Never the admin/superuser connection below.
DATABASE_URL=postgresql://agent_events_writer:agent_events_writer@localhost:5433/pr_review_agent

# Used ONLY to apply migrations (backend.database.postgres.apply_migrations)
# -- the "postgres" superuser docker-compose.yml's postgres service creates.
# Never used by request-path code; creating the restricted role/table/
# trigger requires privileges agent_events_writer is deliberately never
# granted.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/pr_review_agent

# NOTE: pydantic-settings reads DATABASE_URL (and every other variable in
# this file) directly out of .env into the Settings object -- it does NOT
# export them into the shell's own environment. A shell command that reads
# $DATABASE_URL itself (e.g. `psql "$DATABASE_URL"`, as PLAN.md's M7 demo
# command does) will see an empty string unless you export it into the
# shell first, e.g.: `set -a && source .env && set +a` (PLAN.md's M7 demo
# command already does this inline, so it works verbatim in a clean shell).

# M7 L2 DEBUG fix (post-L4-REJECT): reliability knobs for EventRepository's
# own outbound Postgres calls -- independent of the M6 knobs above, which
# guard an unrelated dependency (Redis). connect_timeout (not settings-
# configurable; see EventRepository's constructor) bounds only the TCP
# handshake, never query execution or lock-wait time -- an independent L4
# VERIFY session proved that gap empirically: a webhook whose events write
# stalled behind a real Postgres table lock blocked the *entire* uvicorn
# event loop, serialising every other concurrent, unrelated request behind
# it. These three settings, plus offloading the write to a worker thread
# (backend/observability/events.py's emit_decision_async), are the fix.

# Postgres's own statement_timeout (milliseconds), applied to every
# EventRepository connection -- bounds query execution AND lock-wait time,
# which connect_timeout alone does not cover.
EVENTS_STATEMENT_TIMEOUT_MS=2000

# Consecutive failures required to trip EventRepository's own circuit
# breaker to OPEN (fail-fast; no further Postgres attempts for the events
# write until the reset window below elapses). Independent of
# CIRCUIT_BREAKER_FAILURE_THRESHOLD above, which guards Redis.
EVENTS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# How long (seconds) EventRepository's breaker stays OPEN before allowing a
# single HALF_OPEN probe call through to check whether Postgres has
# recovered.
EVENTS_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# M8: the first real, LLM-backed specialist (security). See
# backend/tools/llm_client.py, backend/agents/security_agent.py,
# backend/economics/budget.py.

# Anthropic API key. Deliberately left blank/unset in this example file --
# every unit test in this project passes without it (a fake LLM client
# stands in for the real Anthropic SDK client); only the live demo command
# (`python -m backend.agents.security_agent --diff ...`) needs a real
# value. Never commit a real key.
ANTHROPIC_API_KEY=

# The driver model every LLM-backed specialist agent calls. Deliberately
# Haiku, not Opus/Sonnet -- this project's approved driver model for the
# four per-PR specialist calls (a Sonnet-tier judge model is a separate,
# later concern -- see M13).
ANTHROPIC_MODEL=claude-haiku-4-5

# BudgetGuard's daily USD cap on total LLM spend (backend/economics/budget.py),
# summed from agent_events' llm.call rows (real spend, not an estimate held
# in memory -- see backend/database/repository.py's sum_llm_cost_since).
# Once today's spend meets or exceeds this value, BudgetGuard hard-blocks
# the next LLM call before it ever reaches the Anthropic client.
BUDGET_DAILY_CAP_USD=20

# M8 reliability layer: retry-with-backoff, circuit breaker, and timeout
# settings guarding AnthropicLLMClient's real outbound Anthropic API calls.
# Independent of the M6 (Redis) and M7 (events Postgres) knobs above --
# tuning one outbound dependency's timeout/breaker must never silently
# retune an unrelated one.

# Bound (seconds) on each individual outbound Anthropic API call.
LLM_TIMEOUT_SECONDS=30.0

# Total attempts (including the first) per LLM call before giving up.
LLM_RETRY_MAX_ATTEMPTS=3

# Delay (seconds) before the 2nd LLM retry attempt; grows exponentially
# after that (doubling each attempt), capped at LLM_RETRY_MAX_DELAY_SECONDS,
# with the same full-jitter randomization as the M6/M7 retry policies.
LLM_RETRY_BASE_DELAY_SECONDS=0.5

# Upper bound (seconds) the LLM retry backoff is clamped to.
LLM_RETRY_MAX_DELAY_SECONDS=8.0

# Consecutive failures required to trip the LLM client's circuit breaker to
# OPEN (fail-fast; no further Anthropic API calls attempted until the reset
# window below elapses).
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# How long (seconds) the LLM client's breaker stays OPEN before allowing a
# single HALF_OPEN probe call through to check whether the API has recovered.
LLM_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# M9: hybrid retrieval / local vector memory (backend/memory/). See
# docker-compose.yml's pgvector service comment for the full port/image/
# ANN-index reasoning.

# Connection string for the local pgvector-enabled Postgres instance
# backing code_chunks. Host port 5434 -- not 5432 (an unrelated project's
# container), not 5433 (this project's own M7 events-spine Postgres), not
# 6379/6380 (Redis). A SEPARATE database/instance from DATABASE_URL above
# on purpose: code_chunks is a derived retrieval index with a totally
# different schema/workload from the append-only agent_events table.
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5434/pr_review_memory

# Which Embedder implementation backend.memory.embedder.get_embedder()
# constructs. "fixture" (default) is DeterministicFixtureEmbedder -- no
# network, no key, fully reproducible, and what every test and this
# milestone's own demo command use. "openai" makes real
# text-embedding-3-large calls and requires OPENAI_API_KEY below. There is
# NO OpenAI credential available for this build -- leave this as "fixture"
# unless you have a real key and specifically want a live embedding run
# (see backend/memory/embedder.py's module docstring for exactly what
# differs between the two paths).
EMBEDDER_BACKEND=fixture

# OpenAI API key for the real embedder. Deliberately blank/unset in this
# example file, mirroring ANTHROPIC_API_KEY above -- only needed when
# EMBEDDER_BACKEND=openai. Never commit a real key.
OPENAI_API_KEY=

# The embeddings model OpenAIEmbedder calls. Per the spec's pinned config:
# text-embedding-3-large.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# The dimensionality every embedding in this system must have -- passed as
# OpenAI's own `dimensions` truncation parameter for the real embedder
# (text-embedding-3-large's native output is 3072-dim; this truncates it),
# DeterministicFixtureEmbedder's output width, and code_chunks.embedding's
# VECTOR(256) column width in migrations/scripts/dev-pgvector-init.sql --
# all three must agree. Per the spec's pinned config: 256.
EMBEDDING_DIMENSION=256

# M9 reliability layer: retry-with-backoff, circuit breaker, and timeout
# settings guarding OpenAIEmbedder's real outbound OpenAI API calls --
# independent of the M6 (Redis), M7 (events Postgres), and M8 (Anthropic)
# knobs above, per this project's one-dependency-one-set-of-knobs pattern.

# Bound (seconds) on each individual outbound OpenAI embeddings call.
EMBEDDING_TIMEOUT_SECONDS=30.0

# Total attempts (including the first) per embeddings call before giving up.
EMBEDDING_RETRY_MAX_ATTEMPTS=3

# Delay (seconds) before the 2nd embeddings retry attempt; grows
# exponentially after that, capped at EMBEDDING_RETRY_MAX_DELAY_SECONDS,
# with the same full-jitter randomization as the other retry policies.
EMBEDDING_RETRY_BASE_DELAY_SECONDS=0.5

# Upper bound (seconds) the embeddings retry backoff is clamped to.
EMBEDDING_RETRY_MAX_DELAY_SECONDS=8.0

# Consecutive failures required to trip the embedder's circuit breaker to
# OPEN (fail-fast; no further OpenAI API calls attempted until the reset
# window below elapses).
EMBEDDING_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# How long (seconds) the embedder's breaker stays OPEN before allowing a
# single HALF_OPEN probe call through to check whether the API has recovered.
EMBEDDING_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# Default number of fused results HybridRetriever.hybrid_search returns
# when the caller does not pass an explicit top_k.
HYBRID_RETRIEVAL_TOP_K=5

# The reciprocal rank fusion constant (k in score = sum(1 / (k + rank))).
# 60 is the commonly cited default from the RRF literature (Cormack,
# Clarke & Buettcher, 2009) -- see backend/memory/context_retriever.py.
RRF_K=60

# M11: real GitHub App integration (backend/integrations/{github_client,
# github_auth,diff_mapping}.py, backend/security/rbac.py). See that
# module's docstrings for the full JWT -> installation-token flow.

# Which GitHubClient implementation backend.integrations.github_client.
# build_github_client() constructs. "mock" (default) needs no GitHub App
# credential at all -- every test and a keyless checkout use it. "real"
# makes actual GitHub REST calls (authenticate, fetch diffs, post reviews)
# and requires GITHUB_APP_ID + GITHUB_APP_PRIVATE_KEY_PATH below.
GITHUB_CLIENT_BACKEND=mock

# This project's GitHub App id (the numeric id shown on the App's settings
# page, and the 'iss' claim of every app-level JWT it mints). Only needed
# when GITHUB_CLIENT_BACKEND=real.
GITHUB_APP_ID=

# Filesystem path to the GitHub App's PEM-encoded RSA private key.
# NEVER commit the real .pem file -- secrets/ and *.pem are gitignored
# (see .gitignore's "GitHub App credentials" block). Read fresh from disk
# at RealGitHubClient construction time; never logged.
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem

# Base URL for the real GitHub REST API. Overridable for testing against a
# fake server; leave as the default for real use.
GITHUB_API_BASE_URL=https://api.github.com

# M11 reliability layer: retry-with-backoff, circuit breaker, and timeout
# settings guarding RealGitHubClient's real outbound GitHub REST calls --
# independent of the M6/M7/M8/M9 knobs above, per this project's
# one-dependency-one-set-of-knobs pattern. Slightly more generous than the
# Redis/events knobs since GitHub is a public internet dependency, not a
# same-docker-network service.

# Bound (seconds) on each individual outbound GitHub REST API call.
GITHUB_TIMEOUT_SECONDS=15.0

# Total attempts (including the first) per GitHub REST call before giving up.
GITHUB_RETRY_MAX_ATTEMPTS=3

# Delay (seconds) before the 2nd GitHub retry attempt; grows exponentially
# after that, capped at GITHUB_RETRY_MAX_DELAY_SECONDS, with the same
# full-jitter randomization as the other retry policies.
GITHUB_RETRY_BASE_DELAY_SECONDS=0.5

# Upper bound (seconds) the GitHub retry backoff is clamped to.
GITHUB_RETRY_MAX_DELAY_SECONDS=8.0

# Consecutive failures required to trip RealGitHubClient's circuit breaker
# to OPEN (fail-fast; no further GitHub API calls attempted until the reset
# window below elapses).
GITHUB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# How long (seconds) RealGitHubClient's breaker stays OPEN before allowing
# a single HALF_OPEN probe call through to check whether GitHub's API has
# recovered.
GITHUB_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# M12: Tiger Cloud migration (backend/database/postgres.py's
# init_tiger_schema, backend/memory/tiger_client.py, backend/core/settings.py).
# See migrations/scripts/2026-06-tiger-init.sql for the schema this
# provisions (Stages A-C: extensions, the real agent_events hypertable +
# append-only enforcement + continuous aggregates, and the DiskANN-backed
# code_chunks).

# Which store agent_events / code_chunks actually live on. "local"
# (default, leave unset/as-is below) needs NO Tiger Cloud account at all --
# every test and a keyless checkout use it. "tiger" opts into the real,
# paid Tiger Cloud instance below. Independent knobs (mirroring
# EMBEDDER_BACKEND/JOB_QUEUE_BACKEND/GITHUB_CLIENT_BACKEND's own
# per-dependency backend selection) -- you can run events on Tiger while
# memory stays local, or vice versa.
EVENTS_BACKEND=local
MEMORY_BACKEND=local

# Tiger Cloud connection, PRIMARY path: libpq's own native PG* environment
# variables -- psycopg AND psql both already read these with zero code in
# this project needed for that to work. Get these from your Tiger Cloud
# service's connection details page. PGPASSWORD is a real secret -- never
# commit a real value, never print/log it (this file's own placeholder
# below is never a real credential).
PGHOST=
PGPORT=
PGUSER=tsdbadmin
PGPASSWORD=
PGDATABASE=tsdb
PGSSLMODE=require

# Tiger Cloud connection, OPTIONAL explicit override: a single bundled DSN,
# for the cases that genuinely want one string instead of six separate
# PG* variables (e.g. a CI secret). Takes precedence over PG* above when
# set; leave unset (the common case, and this project's own actual
# configuration) to use the PRIMARY path above instead. See
# Settings.resolve_tiger_dsn's docstring for the full reasoning.
TIGER_DATABASE_URL=

# Password for the restricted `agent_events_writer` role
# migrations/scripts/2026-06-tiger-init.sql creates on Tiger Cloud (SELECT+
# INSERT only, UPDATE/DELETE/TRUNCATE revoked -- LOAD-BEARING on a
# hypertable, not merely defense in depth; see that file's Stage B comment
# for why). Set once, out of band, via `ALTER ROLE agent_events_writer
# PASSWORD '...'` by whoever provisions a given Tiger instance -- never
# generated by application code, never the same value as PGPASSWORD above
# (that is the ADMIN/tsdbadmin credential, used only to apply migrations).
# Required for EVENTS_BACKEND=tiger application runtime.
TIGER_EVENTS_WRITER_PASSWORD=
