# Copy this file to .env for local development. Never commit the real .env
# (it is gitignored) — this file documents the shape only, with a placeholder
# value, not a real secret.

# Shared secret GitHub signs webhook request bodies with (HMAC-SHA256).
# When registering a real GitHub App/webhook later (M11), set this to the
# secret configured on that webhook. For local M2 development, any non-empty
# string works as long as scripts/send_signed_webhook.py is invoked with the
# same value via --secret.
GITHUB_WEBHOOK_SECRET=change-me-to-a-real-shared-secret

# Which JobQueue implementation backend.api.main.create_app() wires up by
# default (M3+). "in_memory" needs no Docker and is what the plain webhook
# tests use; "redis" is the real queue used by docker-compose.yml + the
# ARQ worker (backend/job_queue/arq_worker.py). Leave as in_memory unless
# you've run `docker compose up -d redis` and want the app itself (not
# just the integration tests) to use the real queue.
JOB_QUEUE_BACKEND=in_memory

# Redis connection string for RedisJobQueue and the ARQ worker. Defaults
# to the host port docker-compose.yml publishes locally -- 6380, not
# Redis's usual 6379, because 6379 may already be in use by an unrelated
# service on your machine (see docker-compose.yml's comment). Change the
# port here if you changed the docker-compose.yml mapping to match.
REDIS_URL=redis://localhost:6380/0

# How long (seconds) a webhook X-GitHub-Delivery id is remembered in Redis
# before its idempotency key expires. GitHub retries a failed delivery for
# roughly 24 hours, so this must comfortably outlive that window. Default
# is one week (604800s); see backend/core/settings.py for the full
# rationale.
IDEMPOTENCY_TTL_SECONDS=604800

# M5's HITL (human-in-the-loop) confidence gate. A review whose
# overall_confidence is at or above this value, AND that contains no
# CRITICAL finding, is auto-posted; otherwise (confidence below this
# threshold, OR any CRITICAL finding present regardless of confidence) it
# is queued for human review instead. Exactly-at-threshold auto-posts (the
# routing test is "below threshold", not "at or below") -- see
# backend/hitl/queue.py's route_review for the exact rule and
# tests/unit/test_hitl_gate.py for the boundary tests. Default is 0.75.
HITL_CONFIDENCE_THRESHOLD=0.75
