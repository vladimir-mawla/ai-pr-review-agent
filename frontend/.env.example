# Copy to frontend/.env.local for local development (Next.js loads
# .env.local automatically; it is gitignored the same way the repo root's
# real .env is -- never commit one with a real value here, though nothing
# in this file is actually a secret).

# Base URL of the backend FastAPI app (backend/api/main.py) the dashboard's
# Client Components fetch backend/api/dashboard.py's JSON routes from.
# NEXT_PUBLIC_ prefix is required -- Next.js only inlines env vars with
# this prefix into browser-side bundles; everything else stays server-only
# and would be invisible to the client-side fetches src/lib/api.ts makes.
# Defaults to http://localhost:8000 in src/lib/api.ts if unset, matching
# `uvicorn backend.api.main:app`'s default local port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
